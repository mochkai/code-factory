# code-factory settings. Copy to .env (git-ignored) and fill in; every line is optional.
# Environment variables override values in this file.

# --- Paths (~ is expanded) ---
# Agent role profiles (<role>.md)
CF_AGENTS_DIR=~/agents/agents
# Skills library (<skill>/SKILL.md)
CF_SKILLS_DIR=~/skills
# Runtime data: factory.db, checkpoints.db, worktrees, logs
CF_DATA_DIR=~/.local/share/code-factory

# --- Worker ---
# Tasks run at once: 1 or 2 (usage limits are shared with your interactive Claude use)
CF_CONCURRENCY=1
# Pause work when the 5-hour / weekly usage window reaches this percentage
CF_USAGE_LIMIT_5H=75
CF_USAGE_LIMIT_WEEK=90

# --- HTTP API (loopback only; any other host is rejected) ---
CF_API_HOST=127.0.0.1
CF_API_PORT=8765
# Bearer token the API requires; generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CF_API_TOKEN=

# --- Claude billing guard ---
# ANTHROPIC_API_KEY switches billing from your Claude login to the API. code-factory refuses to
# run while it is set unless this is true.
CF_ALLOW_API_KEY=false

# --- Notifications (same keys as the old agent farm) ---
# Recipient of the notification emails; leave empty to disable email.
# Tip: a +alias (you+agentfarm@example.com) lands in your normal inbox and is easy to filter.
NOTIFY_EMAIL=you+agentfarm@example.com
# Events that notify (comma-separated): ready, needs_human
NOTIFY_ON=ready,needs_human
# msmtp account in ~/.msmtprc used to send
MSMTP_ACCOUNT=gmail
# Sender name shown in your inbox
NOTIFY_FROM_NAME="Agent Farm"
# Sender address in the From header (default: NOTIFY_EMAIL without the +tag)
#NOTIFY_FROM=you@example.com
